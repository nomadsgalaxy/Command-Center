-- cc-share install 0 --no-announce --autostart
systemctl --user daemon-reload
systemctl --user is-enabled -q control-center-announce.service
systemctl --user start control-center-share@0.service control-center-guard.service control-center-agent.service
systemctl --user is-enabled -q control-center-announce.service
systemctl --user enable control-center-share@0.service control-center-guard.service control-center-agent.service
systemctl --user restart control-center-agent.service
systemctl --user restart control-center-guard.service
systemctl is-active -q firewalld
systemctl is-active -q ufw
systemctl --user disable --now control-center-announce.service
systemctl --user daemon-reload
systemctl is-active -q firewalld
systemctl is-active -q ufw
systemctl --user show-environment
systemctl --user is-active -q control-center-agent
systemctl --user is-active -q control-center-guard
systemctl --user is-active -q control-center-announce.service
loginctl show-user tester -p Linger --value
systemctl --user is-active -q control-center-announce.service
-- cc-share uninstall
systemctl is-active -q firewalld
systemctl is-active -q ufw
systemctl --user disable --now control-center-announce.service
systemctl --user stop control-center-frame@f1-[0-9].service control-center-window@f1-[0-9]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].service
systemctl --user kill -s HUP control-center-agent
systemctl is-active -q firewalld
systemctl is-active -q ufw
systemctl --user disable --now control-center-agent.service
systemctl --user stop control-center-share@* control-center-guard.service
systemctl --user daemon-reload
