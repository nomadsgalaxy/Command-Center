-- cc-share check
systemctl is-active -q firewalld
systemctl is-active -q ufw
systemctl --user is-active -q control-center-agent
systemctl --user is-active -q control-center-guard
systemctl --user is-active -q control-center-announce.service
loginctl show-user tester -p Linger --value
-- cc-share fix --yes
systemctl is-active -q firewalld
systemctl is-active -q ufw
sudo -v
sudo systemctl enable --now avahi-daemon
sudo cp -p HOME/avahi-daemon.conf HOME/avahi-daemon.conf.before-command-center
sudo install -m 644 HOME/.config/control-center/avahi-daemon.conf.new HOME/avahi-daemon.conf
sudo systemctl restart avahi-daemon
