#!/bin/bash
# Check Command Center's shared clipboard over SSH: put a test string on one machine's
# clipboard, then read every other machine's. Run while cc-panels is connected to them.
#   tests/clipboard-check [from-host]       (default: the first host; hosts from viewers.conf)
# Desktop clipboards go through Klipper over D-Bus (no wl-clipboard needed), else wl-copy/wl-paste.
set -u
hosts=$(awk '!/^#/ && NF >= 2 {split($2, a, ":"); print a[1]}' ~/.config/control-center/viewers.conf | sort -u)
from=${1:-$(echo "$hosts" | head -1)}
tag="cc-clipboard-check-$(date +%s)"
env='export XDG_RUNTIME_DIR=/run/user/$(id -u) WAYLAND_DISPLAY=wayland-0 DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$(id -u)/bus'

set_clip() {  # host text
  ssh -o BatchMode=yes "$1" bash -s -- "$2" <<EOS
$env
if qdbus6 org.kde.klipper /klipper >/dev/null 2>&1; then qdbus6 org.kde.klipper /klipper setClipboardContents "\$1"
else setsid wl-copy -- "\$1" </dev/null >/dev/null 2>&1 & fi
EOS
}
get_clip() {  # host
  ssh -o BatchMode=yes "$1" bash -s <<EOS
$env
if qdbus6 org.kde.klipper /klipper >/dev/null 2>&1; then qdbus6 org.kde.klipper /klipper getClipboardContents
else timeout 5 wl-paste --no-newline; fi
EOS
}

echo "copy on $from: $tag"
set_clip "$from" "$tag"
sleep 3
fail=0
for h in $hosts; do
  [ "$h" = "$from" ] && continue
  got=$(get_clip "$h" 2>/dev/null)
  if [ "$got" = "$tag" ]; then echo "  $h: ok"; else echo "  $h: FAIL (has: ${got:0:60})"; fail=1; fi
done
exit $fail
