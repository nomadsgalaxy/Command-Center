+// Command Center (--window): KWin's window management, for one window's geometry, its active state
+// and activating it. Granted only to the window server's own executable (its own .desktop file),
+// never to the monitor servers.
+class WindowManagement : public QWaylandClientExtensionTemplate<WindowManagement>, public QtWayland::org_kde_plasma_window_management
+{
+public:
+    // One for the whole process, never freed: KWin keeps sending it events (every window that
+    // opens), and a freed one crashed the server once its first session ended.
+    static WindowManagement *self()
+    {
+        static auto *wm = new WindowManagement();
+        return wm;
+    }
+
+private:
+    WindowManagement()
+        : QWaylandClientExtensionTemplate<WindowManagement>(16)
+    {
+        initialize();
+    }
+};
+
+class PlasmaWindow : public QtWayland::org_kde_plasma_window
+{
+public:
+    QRect geometry; // frame geometry, logical, integer (KWin sends toRect())
+    bool active = false;
+    std::function<void()> gone;
+
+    ~PlasmaWindow() override
+    {
+        if (isInitialized()) {
+            destroy(); // no more events for this handle once its session is gone
+        }
+    }
+
+protected:
+    void org_kde_plasma_window_geometry(int32_t x, int32_t y, uint32_t width, uint32_t height) override
+    {
+        geometry = QRect(x, y, int(width), int(height));
+    }
+    void org_kde_plasma_window_state_changed(uint32_t flags) override
+    {
+        active = flags & QtWayland::org_kde_plasma_window_management::state_active;
+    }
+    void org_kde_plasma_window_unmapped() override
+    {
+        if (gone) {
+            gone();
+        }
+    }
+};
