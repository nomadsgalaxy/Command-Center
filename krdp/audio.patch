+// SPDX-FileCopyrightText: 2026 Command Center
+//
+// SPDX-License-Identifier: LGPL-2.1-only OR LGPL-3.0-only OR LicenseRef-KDE-Accepted-LGPL
+
+#pragma once
+
+#include <memory>
+
+#include "krdp_export.h"
+
+namespace KRdp
+{
+
+class RdpConnection;
+
+/**
+ * Sound and microphone for one RDP session, over rdpsnd and audin.
+ *
+ * Nothing starts until the client joins the rdpsnd channel, so a session whose client doesn't ask
+ * for audio costs nothing. Then the host's default output (its sink's monitor, through PipeWire)
+ * is sent to the client as 48 kHz stereo PCM, and the client's microphone is published as a
+ * PipeWire source called "Steam Frame microphone (Command Center)", which any app can pick.
+ * close() stops both and takes the source away.
+ */
+class KRDP_NO_EXPORT Audio
+{
+public:
+    explicit Audio(RdpConnection *session);
+    ~Audio();
+
+    /// Called from the session's loop: starts the channels once the client has joined them.
+    void update();
+    /// Stops the capture, closes the channels and removes the microphone.
+    void close();
+
+private:
+    class Private;
+    const std::unique_ptr<Private> d;
+};
+
+}
