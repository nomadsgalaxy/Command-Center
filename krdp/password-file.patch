+            qCritical().noquote() << "--password-file" << path << (parser.isSet(u"username"_s) ? file.errorString() : u"needs --username"_s);
+            return 1;
+        }
+        password = QString::fromUtf8(file.readLine());
+        while (password.endsWith(u'\n') || password.endsWith(u'\r')) {
+            password.chop(1);
+        }
+    }
