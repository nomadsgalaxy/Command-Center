[Unit]
Description=Command Center: keep shared monitors encodable while a viewer is connected
After=graphical-session.target
PartOf=graphical-session.target
StartLimitIntervalSec=600
StartLimitBurst=10
OnFailure=control-center-alert@%n.service

[Service]
ExecStart=@HOST@ guard
TimeoutStopSec=20
Restart=on-failure
RestartSec=2s
RestartSteps=5
RestartMaxDelaySec=60s

[Install]
WantedBy=graphical-session.target
